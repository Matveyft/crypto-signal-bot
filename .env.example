# === Database (TimescaleDB) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=trader
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=crypto_signals

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# === Logging ===
# INFO | DEBUG | WARNING
LOG_LEVEL=INFO
LOG_DIR=logs

# === Exchange (public data only, keys NOT needed for this bot) ===
# Never commit real keys. Execution layer (future) will use these.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# === Collectors ===
WS_PING_INTERVAL_SEC=20
CANDLE_FLUSH_INTERVAL_SEC=10

# === Telegram (сигналы в канал + личный бот со статистикой) ===
# Токен от @BotFather:
TELEGRAM_BOT_TOKEN=
# Username канала (бот должен быть админом канала):
TELEGRAM_CHANNEL=@my_crypto_signals
# Ваш числовой chat_id (узнаете командой /start у бота):
TELEGRAM_ADMIN_CHAT_ID=
